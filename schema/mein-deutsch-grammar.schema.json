{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mein-deutsch-grammar.schema.json",
  "title": "Этапы уроков «Mein Deutsch» по темам грамматики",
  "type": "object",
  "required": ["stages"],
  "properties": {
    "note": { "type": "string" },
    "stages": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9-]+(~[a-z0-9-]+)?\\|[0-9]+$" },
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" } }
    }
  },
  "additionalProperties": false
}
