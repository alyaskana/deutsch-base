 "lines": [
  {
   "who": "Jonas",
   "voice": "aTTiK3YzK3dXETpuDE2h",
   "de": "Hallo, Alina! Hier ist Jonas. Am Sonntag gibt es eine Führung. Kommst du?",
   "ru": "Привет, Алина! Это Йонас. В воскресенье будет экскурсия. Придёшь?",
   "tag": "[am Telefon]"
  },
  {
   "who": "Alina",
   "voice": "4yZGYlR0JpmqiCxBgPi5",
   "de": "Am Sonntag? Hm…",
   "ru": "В воскресенье? Хм…"
  },
  {
   "who": "Jonas",
   "voice": "aTTiK3YzK3dXETpuDE2h",
   "de": "Hast du am Sonntag keine Zeit?",
   "ru": "У тебя в воскресенье нет времени?"
  },
  {
   "who": "Alina",
   "voice": "4yZGYlR0JpmqiCxBgPi5",
   "de": "Doch, ich habe Zeit! Wann ist die Führung?",
   "ru": "Есть, у меня есть время! Когда экскурсия?"
  },
  {
   "who": "Jonas",
   "voice": "aTTiK3YzK3dXETpuDE2h",
   "de": "Um zwölf. Ich treffe dich um halb zwölf, ne?",
   "ru": "В двенадцать. Встречу тебя в половине двенадцатого, ладно?"
  },
  {
   "who": "Alina",
   "voice": "4yZGYlR0JpmqiCxBgPi5",
   "de": "Gut. Mit wem gehen wir?",
   "ru": "Хорошо. С кем мы идём?"
  },
  {
   "who": "Jonas",
   "voice": "aTTiK3YzK3dXETpuDE2h",
   "de": "Mit Paul.",
   "ru": "С Паулем."
  },
  {
   "who": "Alina",
   "voice": "4yZGYlR0JpmqiCxBgPi5",
   "de": "Super! Wie viel kostet der Eintritt?",
   "ru": "Супер! Сколько стоит вход?"
  },
  {
   "who": "Jonas",
   "voice": "aTTiK3YzK3dXETpuDE2h",
   "de": "Acht Euro.",
   "ru": "Восемь евро."
  },
  {
   "who": "Alina",
   "voice": "4yZGYlR0JpmqiCxBgPi5",
   "de": "Und wie ist das Wetter am Sonntag?",
   "ru": "А какая погода в воскресенье?"
  },
  {
   "who": "Jonas",
   "voice": "aTTiK3YzK3dXETpuDE2h",
   "de": "Am Sonntag scheint die Sonne.",
   "ru": "В воскресенье светит солнце."
  },
  {
   "who": "Alina",
   "voice": "4yZGYlR0JpmqiCxBgPi5",
   "de": "Schön! Dann komme ich. Tschüss, Jonas!",
   "ru": "Здорово! Тогда приду. Пока, Йонас!"
  },
  {
   "who": "Jonas",
   "voice": "aTTiK3YzK3dXETpuDE2h",
   "de": "Tschüss!",
   "ru": "Пока!"
  }
 ],
