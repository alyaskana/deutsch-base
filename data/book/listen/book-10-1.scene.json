  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "aufstehen. Ich stehe um sieben Uhr auf.",
   "ru": "aufstehen — Я встаю в семь часов."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "verstehen. Ich verstehe die Frage.",
   "ru": "verstehen — Я понимаю вопрос."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "anrufen. Paul ruft seine Mutter an.",
   "ru": "anrufen — Пауль звонит маме."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "fernsehen. Jonas sieht am Abend fern.",
   "ru": "fernsehen — Йонас вечером смотрит телевизор."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "einkaufen. Wir kaufen am Samstag ein.",
   "ru": "einkaufen — Мы закупаемся в субботу."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "erklären. Die Lehrerin erklärt die Regel.",
   "ru": "erklären — Учительница объясняет правило."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "umziehen. Alina zieht nach Köln um.",
   "ru": "umziehen — Алина переезжает в Кёльн."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "übernachten. Wir übernachten im Hotel.",
   "ru": "übernachten — Мы ночуем в гостинице."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "unterschreiben. Sie unterschreibt den Vertrag.",
   "ru": "unterschreiben — Она подписывает договор."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "frühstücken. Ich frühstücke um acht.",
   "ru": "frühstücken — Я завтракаю в восемь."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "mitnehmen. Paul nimmt den Schirm mit.",
   "ru": "mitnehmen — Пауль берёт с собой зонт."
  },
  {
   "who": "Sprecher",
   "voice": "X3GmkxFRIWulRy3Eaur7",
   "de": "wiederholen. Bitte wiederholen Sie den Satz.",
   "ru": "wiederholen — Пожалуйста, повторите предложение."
  }
